# Server
PORT=3002
FRONTEND_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=tujitunze

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600

# Password reset email. MAIL_* is preferred; SMTP_* remains supported as
# an alias (see getMailConfig() in auth.service.ts). For Gmail, MAIL_USER
# is the full Gmail address and MAIL_PASSWORD is a 16-character Gmail
# App Password (myaccount.google.com/apppasswords) — never the normal
# account password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# Phone password reset (Africa's Talking)
SMS_PROVIDER=africastalking
SMS_API_URL=https://api.africastalking.com/version1/messaging
SMS_USERNAME=
SMS_API_KEY=
SMS_SENDER_ID=TUJITUNZE

# Telecom webhook intake (POST /telecom/webhooks/contribution). Per-operator
# credentials (api_key_hash, webhook_secret) live in telecom_operators, not
# here — this only tunes the shared replay-protection window used by
# TelecomWebhookSignatureGuard to reject a stale/replayed signed request.
TELECOM_WEBHOOK_REPLAY_TOLERANCE_MS=300000

# Bank webhook intake (POST /bank/webhooks/transaction). Per-bank
# credentials (api_key_hash, webhook_secret) live in banks, not here — this
# only tunes the shared replay-protection window used by
# BankWebhookSignatureGuard to reject a stale/replayed signed request.
BANK_WEBHOOK_REPLAY_TOLERANCE_MS=300000
