# Server
PORT=3002
FRONTEND_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=tujitunze

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600

# Encrypts telecom_operators.webhook_secret / banks.webhook_secret at
# rest (AES-256-GCM) — required before any Telecom/Bank staff can
# configure a webhook. Must be a 64-character hex string (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET_ENCRYPTION_KEY=

# Password reset email. MAIL_* is preferred; SMTP_* remains supported as
# an alias (see getMailConfig() in auth.service.ts). For Gmail, MAIL_USER
# is the full Gmail address and MAIL_PASSWORD is a 16-character Gmail
# App Password (myaccount.google.com/apppasswords) — never the normal
# account password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# Phone password reset (Africa's Talking)
SMS_PROVIDER=africastalking
SMS_API_URL=https://api.africastalking.com/version1/messaging
SMS_USERNAME=
SMS_API_KEY=
SMS_SENDER_ID=TUJITUNZE

# Telecom webhook intake (POST /telecom/webhooks/contribution). Per-operator
# credentials (api_key_hash, webhook_secret) live in telecom_operators, not
# here — this only tunes the shared replay-protection window used by
# TelecomWebhookSignatureGuard to reject a stale/replayed signed request.
TELECOM_WEBHOOK_REPLAY_TOLERANCE_MS=300000

# Bank webhook intake (POST /bank/webhooks/transaction). Per-bank
# credentials (api_key_hash, webhook_secret) live in banks, not here — this
# only tunes the shared replay-protection window used by
# BankWebhookSignatureGuard to reject a stale/replayed signed request.
BANK_WEBHOOK_REPLAY_TOLERANCE_MS=300000

# ============================================================
# Vodacom M-Pesa — two integration layers currently exist:
#
# 1. backend/src/modules/payments/vodacom-mpesa/ — an earlier,
#    still-dormant foundation (config/session-cache/HTTP-client
#    scaffolding) built before any real Vodacom endpoint was
#    documented. Every real operation there (including its own
#    generateSession()) still throws VodacomEndpointNotDocumentedError
#    and is not wired into the running app.
#
# 2. backend/src/modules/telecom/vodacom/ — the REAL, working
#    implementation (this integration's actual STEP), wired into the
#    live TelecomModule. GET /telecom/vodacom/test-connection (Admin
#    only) genuinely calls Vodacom's sandbox getSession endpoint when
#    the variables below are set. This is NOT a mock.
#
# VODACOM_MPESA_ENV, VODACOM_MPESA_API_KEY, VODACOM_MPESA_TIMEOUT_MS, and
# VODACOM_MPESA_MAX_RETRIES are read by BOTH layers with the same
# meaning in each — set once. The remaining variables below
# (BASE_URL/MARKET/PUBLIC_KEY/ORIGIN) are specific to the real (layer 2)
# implementation.
#
# NEVER commit real values here — this file stays placeholders only.
# Sandbox and production are DIFFERENT hosts for this class of API —
# never the same URL with a flag. VODACOM_MPESA_ENV must be exactly
# "production" to leave sandbox mode; any other/missing value fails
# closed to sandbox. The production getSession path is not documented
# for this integration and is deliberately unsupported until it is.
VODACOM_MPESA_ENV=sandbox
VODACOM_MPESA_API_KEY=
VODACOM_MPESA_TIMEOUT_MS=15000
VODACOM_MPESA_MAX_RETRIES=2

# Real (layer 2) connection details — GET /telecom/vodacom/test-connection.
VODACOM_MPESA_BASE_URL=https://openapi.m-pesa.com
VODACOM_MPESA_MARKET=vodacomTZN
# The platform's public RSA key used to encrypt VODACOM_MPESA_API_KEY
# before it is sent (per the official Vodacom M-Pesa OpenAPI docs) —
# either the bare base64 SPKI DER blob (as issued on the developer
# portal, no PEM markers) or a full "-----BEGIN PUBLIC KEY-----" block.
# This is Vodacom's PUBLIC key, safe to store, but never left blank in
# a real environment — session generation fails closed without it.
VODACOM_MPESA_PUBLIC_KEY=
# The Origin header value the sandbox expects — obtain from the
# Vodacom M-Pesa Developer Portal application configuration.
VODACOM_MPESA_ORIGIN=
# Not required for session generation / the Telecom connection-test
# endpoint (GET getSession only needs BASE_URL/MARKET/API_KEY/ORIGIN/
# PUBLIC_KEY above) — only for the C2B Single Stage payment call.
VODACOM_MPESA_SERVICE_PROVIDER_CODE=

# ---- Foundation-only (layer 1) values, still unused in production ----
VODACOM_MPESA_API_BASE_URL=
VODACOM_MPESA_APPLICATION_ID=
VODACOM_MPESA_SESSION_PATH=
VODACOM_MPESA_SESSION_LIFETIME_SECONDS=3000
VODACOM_MPESA_SESSION_REFRESH_MARGIN_SECONDS=120
